{
  "name": "portifolio-rafa-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ],
  "scripts": {
    "dev": "bun --filter portifolio dev",
    "build": "bun --filter portifolio build",
    "preview": "bun --filter portifolio preview",
    "check": "bun --filter portifolio check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gs:build": "bun --filter gas build",
    "gs:check": "bun --filter gas check",
    "gs:test": "bun --filter gas test",
    "gs:deploy": "bun --filter gas deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}
