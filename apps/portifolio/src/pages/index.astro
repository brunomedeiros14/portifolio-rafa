---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import MediaFrame from '../components/MediaFrame.astro';
import Prose from '../components/Prose.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WeddingGrid from '../components/WeddingGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absolute } from '../site.config';
import { ogImageFrom } from '../utils/og';

import portrait from '../assets/profile.png';
import { ID, node, personRef } from '../utils/schema';
import {
  getGalleryItems,
  getWeddingImages,
  weddingFolder,
  type GalleryItem,
} from '../utils/weddings';

const EXPERIENCE = [
  {
    step: '01',
    title: 'Conversa',
    text: 'Café, vídeo ou mensagem. Conte a história de vocês, o lugar, o estilo — e eu mostro como trabalho, sem enrolação. Saímos da conversa com o roteiro do dia, horários e os lugares que importam para vocês.',
  },
  {
    step: '02',
    title: 'O grande dia',
    text: 'Presença discreta do início ao fim: preparativos, cerimônia, retratos e festa. Sem cronômetro, acompanhando o ritmo da emoção.',
  },
  {
    step: '03',
    title: 'História entregue',
    text: 'Curadoria e edição com calma. Em até 60 dias você recebe suas melhores fotografias, prontas para imprimir e eternizar, em alta resolução e com autorização de uso plena.',
  },
];

const INCLUDED = [
  'Cobertura do preparo à pista de dança',
  'Dois fotógrafos nos dias inteiros',
  'Ensaios pré-casamento ou no dia',
  'Galeria online com todas as imagens',
  'Suporte humano antes e depois da festa',
];

const featured = (await getCollection('weddings', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const heroWedding = featured[0];

// Seleção editorial: algumas fotografias fortes de histórias próximas.
const selected: GalleryItem[] = [];
for (const wedding of featured.slice(0, 3)) {
  const images = getWeddingImages(weddingFolder(wedding), wedding.data.cover).slice(0, 3);
  selected.push(...getGalleryItems(images, wedding.data.couple));
}

// A home não é uma página de casamento: o compartilhamento mostra o retrato,
// não a capa de um casal específico. O JSON-LD segue a mesma imagem.
const portraitOg = await ogImageFrom(portrait);

// A Person fica num bloco próprio para que autor, publisher e provider em
// outras páginas possam apontar para o mesmo @id.
const person = node({
  '@type': 'Person',
  '@id': ID.person,
  name: personRef().name,
  jobTitle: SITE.role,
  description: SITE.description,
  url: absolute('/sobre'),
  image: absolute(portraitOg.src),
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.state,
    addressCountry: 'BR',
  },
  knowsAbout: SITE.areas.filter((area) => !area.startsWith('muito')),
  sameAs: [SITE.instagram],
  ...(SITE.email ? { email: SITE.email } : {}),
  ...(SITE.whatsapp ? { telephone: SITE.whatsapp } : {}),
});

const jsonLd = [
  node({
    '@type': 'ProfessionalService',
    '@id': ID.business,
    name: SITE.name,
    description: SITE.description,
    url: absolute('/'),
    image: absolute(portraitOg.src),
    priceRange: '$$$',
    founder: { '@id': ID.person },
    employee: { '@id': ID.person },
    areaServed: SITE.areas
      .filter((area) => !area.startsWith('muito'))
      .map((city) => ({ '@type': 'City', name: city })),
    serviceType: 'Fotografia de casamento',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Serviços',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: 'Cobertura completa do casamento' },
        },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Ensaio pré-wedding' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Álbum e组图 de impressão' } },
      ],
    },
  }),
  node({
    '@type': 'WebSite',
    '@id': ID.website,
    url: absolute('/'),
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': ID.person },
    inLanguage: SITE.language,
  }),
  person,
];
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  {heroWedding ? (
    <Hero
      image={heroWedding.data.cover}
      alt={heroWedding.data.excerpt}
      eyebrow={`${SITE.role} · ${SITE.city}, ${SITE.state}`}
      title="Histórias de amor, fotografadas como acontecem"
      subtitle="Fotografia editorial e documental de casamento em Belo Horizonte, Nova Lima, Ouro Preto, Tiradentes e toda Minas Gerais."
      ctas={[
        { label: 'Vamos conversar', href: '/contato', primary: true },
        { label: 'Ver casamentos', href: '/casamentos' },
      ]}
    />
  ) : null}

  {/* Declaração. Fica entre o hero e o portfólio como um respiro: uma frase só,
      em display, antes de qualquer lista. O fio de 4rem é o que segura o bloco
      na tela larga — sem ele o texto solta no meio da viewport. */}
  <Section rhythm="page" class="text-center">
    <div class="mx-auto max-w-3xl">
      <Eyebrow class="!justify-center">Fotografia de casamento</Eyebrow>
      <Reveal
        as="h2"
        delay={80}
        class="mt-6 font-display text-3xl leading-[1.08] font-medium tracking-tight text-balance sm:text-4xl md:text-[3.4rem]"
      >
        Não fotografo o que é <em class="text-accent italic">perfeito</em>. Fotografo o que é
        verdadeiro.
      </Reveal>
      <Reveal as="p" delay={160} class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-muted">
        Sou Rafael Dias, fotógrafo de casamento e estudante de Fotografia. Busco uma fotografia
        natural, elegante e emocional, com uma estética cinematográfica — mas sem perder a verdade
        das pessoas e dos lugares. Observo gestos, expressões e aquilo que muitas vezes acontece em
        silêncio.
      </Reveal>
    </div>
  </Section>

  {/* Portfólio. A linha de catálogo antes do texto: o código do item é o que
      transforma um grid de fotos em índice, e ele precisa estar na mesma
      altura da primeira linha da capa. */}
  <Section tone="surface">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-16">
      <SectionHeading
        eyebrow="Histórias recentes"
        title="Casamentos selecionados"
        description="Uma pequena seleção das cerimônias mais bonitas que fotografei por Minas Gerais."
        class="md:flex-1"
      />
      <p class="max-w-sm text-sm leading-relaxed text-muted md:pb-2">
        Cada dia inteiro vivido ao lado de famílias, padrinhos e amigos. Navegue pelas histórias e
        veja o clima de cada festa como se estivesse lá.
      </p>
    </div>
    <div class="mt-14">
      <WeddingGrid weddings={featured} priorityFirst />
    </div>
    <Reveal class="mt-12">
      <a
        href="/casamentos"
        class="link-line inline-flex items-center gap-2 text-sm font-medium text-accent"
        data-astro-prefetch
      >
        Ver todos os casamentos
        <span aria-hidden="true">→</span>
      </a>
    </Reveal>
  </Section>

  {/* Abordagem. A imagem é o retrato do fotógrafo, não a capa de um casal: a
      seção fala de método, e a foto precisa sustentar o assunto. */}
  <Section aria-labelledby="abordagem-heading">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <Reveal class="md:col-span-5">
        <MediaFrame ratio="4/5">
          <Picture
            src={portrait}
            alt="Rafael Dias em campo, fotografando ao entardecer"
            widths={[480, 1280]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={1280}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </MediaFrame>
      </Reveal>
      <div class="md:col-span-6 md:col-start-7">
        <SectionHeading
          eyebrow="Sobre"
          title="Uma abordagem editorial e humana"
          headingId="abordagem-heading"
        />
        <Reveal class="mt-7">
          <Prose class="text-muted">
            <p class="!mt-0">
              Acredito que fotografia de casamento não é sobre poses perfeitas, e sim sobre
              preservar o que aconteceu de verdade: o nervosismo antes da entrada, a risada da
              madrinha, o abraço apertado no final da noite.
            </p>
            <p>
              Trabalho com luz natural, pouca direção e bastante presença. Cada casamento é tratado
              como uma história editorial — com começo, meio, fim e emoção.
            </p>
            <p>
              Meu compromisso é devolver a vocês imagens que despertem a memória vivida: a textura
              do vestido, o som da música que embalou a primeira dança. Por isso fotografo o
              essencial e deixo o resto falar.
            </p>
          </Prose>
        </Reveal>
        <Reveal class="mt-8">
          <Button href="/sobre" variant="secondary" prefetch>
            Sobre mim
          </Button>
        </Reveal>
      </div>
    </div>
  </Section>

  {/* Seleção editorial — fotografias soltas, em fundo escuro */}
  <Section tone="ink">
    <div class="grid gap-8 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <Eyebrow onInk>Seleção editorial</Eyebrow>
        <h2 class="mt-3 font-display text-3xl font-medium tracking-tight text-white sm:text-4xl">
          Fotografias que já guardaram histórias
        </h2>
      </div>
      <p class="text-sm leading-relaxed text-white/65 md:col-span-5 md:col-start-8 md:pt-8">
        Momentos separados das galerias completas: detalhes, emoção e encontros que resumem como as
        histórias de amor acontecem em cada casamento que acompanho.
      </p>
    </div>
    <div class="mt-14">
      <Gallery id="home-editorial" items={selected} />
    </div>
  </Section>

  {/* Como funciona. Numeral grande na margem e um fio que atravessa as três
      etapas: a lista vira sequência, não três blocos soltos. */}
  <Section aria-labelledby="experiencia-heading">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-16">
      <SectionHeading
        eyebrow="Como funciona"
        title="Sua experiência comigo"
        headingId="experiencia-heading"
        class="md:flex-1"
      />
      <a
        href="/experiencia"
        class="link-line shrink-0 pb-2 text-sm font-medium text-accent"
        data-astro-prefetch
      >
        Detalhes do processo →
      </a>
    </div>

    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {EXPERIENCE.map((item, index) => (
        <Reveal as="li" delay={index * 90} class="border-t border-line pt-6">
          <p class="font-display text-4xl leading-none text-accent/35 italic">{item.step}</p>
          <h3 class="mt-5 font-display text-xl font-medium tracking-tight">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.text}</p>
        </Reveal>
      ))}
    </ol>

    <Reveal class="mt-16 border-t border-line pt-10">
      <h3 class="font-display text-lg font-medium tracking-tight">Tudo o que entra no contrato</h3>
      <ul class="mt-6 grid gap-x-10 gap-y-3 sm:grid-cols-2">
        {INCLUDED.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
            <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
              ✦
            </span>
            {item}
          </li>
        ))}
      </ul>
    </Reveal>
  </Section>

  {/* Onde atuo. Lista em duas colunas separada por fios em vez de etiquetas
      arredondadas: as cidades leem como texto editorial, e 14 chips viravam
      ruído visual no lugar de informação. */}
  <Section tone="surface" rhythm="tight">
    <div class="grid gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <SectionHeading
          eyebrow="Onde atuo"
          title="Casamentos por Minas Gerais"
          description="De Belo Horizonte às cidades históricas — e com alegria para além de Minas."
        />
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <Reveal as="p" class="text-base leading-relaxed text-muted">
          Atendo casamentos na capital e no interior, sem taxa de deslocamento dentro de Minas. Se a
          festa de vocês sai do estado, combinamos um orçamento transparente para viagem e
          hospedagem.
        </Reveal>
        <ul class="mt-8 grid gap-x-8 sm:grid-cols-2">
          {SITE.areas.map((area) => (
            <li class="flex items-baseline justify-between gap-4 border-t border-line py-3 text-sm">
              <span>{area}</span>
              <span class="shrink-0 text-xs text-muted/70" aria-hidden="true">
                MG
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <CTA />
</BaseLayout>
