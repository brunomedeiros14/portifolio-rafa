---
/**
 * Entrada por rolagem.
 *
 * `.reveal` foi a classe mais usada do projeto (43 ocorrências), quase sempre
 * com o mesmo `--reveal-delay` em `style`. O atraso é uma boa parte do que faz
 * o bloco parecer cascateado em vez de piscar inteiro, então a prop existe para
 * ninguém mais escrever `style=` à mão.
 *
 * O efeito é inerte sem JS (`html.js` no seletor) e some inteiro sob
 * `prefers-reduced-motion`. Ver `global.css`.
 */
interface Props {
  /** Atraso em ms. */
  delay?: number;
  /**
   * O elemento envelopado. Existe para o wrapper não quebrar a outline do
   * leitor de tela: um `div` anonimo entre `<h2>` e `<h3>` não quebra nada,
   * mas um `<div>` no lugar de um `<li>` sim.
   */
  as?:
    'div' | 'section' | 'li' | 'article' | 'header' | 'figure' | 'p' | 'h1' | 'h2' | 'h3' | 'span';
  class?: string;
}

const { delay = 0, as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={['reveal', className]}
  {...(delay > 0 ? { style: `--reveal-delay:${delay}ms` } : {})}
>
  <slot />
</Tag>
