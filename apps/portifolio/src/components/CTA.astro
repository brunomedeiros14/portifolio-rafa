---
import Button from './Button.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vamos conversar sobre o seu casamento?',
  description = 'Conte sua história e descubra como uma fotografia editorial e atemporal pode eternizar o seu dia.',
} = Astro.props;
---

<section class="bg-ink text-white">
  <div class="mx-auto flex max-w-(--content-max) flex-col items-start gap-10 px-(--gutter) py-20 md:flex-row md:items-center md:justify-between md:py-28">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-medium tracking-tight sm:text-4xl md:text-5xl">
        {title}
      </h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-white/70">{description}</p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row">
      <Button href="/contato" prefetch>
        Entrar em contato
      </Button>
      <Button href="/casamentos" variant="on-ink" prefetch>
        Ver portfólio
      </Button>
    </div>
  </div>
</section>
