---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'start' | 'center';
  /** id no <h2>, para permitir aria-labelledby na <section> que o contém */
  headingId?: string;
  /** Sobre `bg-ink`, o rótulo e os títulos precisam do tom claro de acento. */
  onInk?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'start',
  headingId,
  onInk = false,
  class: className,
} = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow ? <Eyebrow onInk={onInk}>{eyebrow}</Eyebrow> : null}
  <h2
    id={headingId}
    class:list={[
      'mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl',
      onInk && 'text-white',
    ]}
  >
    {title}
  </h2>
  {description ? (
    <p class:list={['mt-4 text-base leading-relaxed', onInk ? 'text-white/70' : 'text-muted']}>
      {description}
    </p>
  ) : null}
</div>
