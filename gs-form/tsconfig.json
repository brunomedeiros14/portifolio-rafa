{
  "//": "Typecheck do servidor do Apps Script (gs-form/*.js). O painel em index.html é JavaScript dentro de um template e fica fora daqui — ver F7, quando ele for extraído para um bundle com build step.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // O código é JavaScript puro (o Apps Script não compila TypeScript), mas
    // `checkJs` faz o tsc analisar mesmo assim. Foi o que reprovou o
    // `Cannot redeclare block-scoped variable 'Drive'` — o tipo global `Drive`
    // do Apps Script colidia com o objeto `Drive` do projeto (hoje `Files`).
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "types": ["google-apps-script"],

    "strict": false,
    // `checkJs` só enxerga `*.js`. Globals do template (index.html) e
    // referências cruzadas entre arquivos `.gs` do GAS chegam como `any`
    // aqui; o `@types/google-apps-script` cobre o resto.
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./*.js"],
  "exclude": ["node_modules"]
}
