# Cloudflare Pages — cache e segurança
#
# Os assets em /_astro/ têm hash no nome (ex.: cover.CKJiLKQ__OIMr3.jpeg),
# então podem ser cacheados indefinidamente com segurança.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes também são imutáveis (nome do arquivo versionado).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# HTML: revalidar sempre, para que um deploy novo chegue rápido.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
/casamentos/*
  Cache-Control: public, max-age=0, must-revalidate
/sobre
  Cache-Control: public, max-age=0, must-revalidate
/experiencia
  Cache-Control: public, max-age=0, must-revalidate
/contato
  Cache-Control: public, max-age=0, must-revalidate

# Cabeçalhos de segurança.
# X-Content-Type-Options evita que o navegador reaproveite um download como
# texto quando o tipo declarado não bate.
X-Content-Type-Options: nosniff
# frame-ancestors 'none' substitui o X-Frame-Options e cobre todos os
# navegadores modernos, incluindo os que ignoram XFO em iframes.
Content-Security-Policy: frame-ancestors 'none'
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
X-Frame-Options: DENY
