---
import { NAV_LINKS, SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/85">
  <div class="mx-auto grid max-w-(--content-max) gap-12 px-4 py-16 sm:px-6 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <p class="font-display text-2xl tracking-tight">
        Rafael <span class="italic text-accent-soft">Dias</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/60">
        {SITE.description}
      </p>
      <p class="mt-4 text-sm text-white/70">
        {SITE.city}, {SITE.state}
      </p>
    </div>

    <nav class="md:col-span-3" aria-label="Rodapé">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/45">Navegação</p>
      <ul class="mt-4 space-y-3 text-sm">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="link-line text-white/80 hover:text-white">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/45">Contato</p>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={SITE.whatsappUrl} class="link-line text-white/80 hover:text-white" target="_blank" rel="noopener">
            WhatsApp — {SITE.whatsapp}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="link-line text-white/80 hover:text-white">
            {SITE.email}
          </a>
        </li>
        <li>
          <a href={SITE.instagram} class="link-line text-white/80 hover:text-white" target="_blank" rel="noopener">
            {SITE.instagramHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-(--content-max) flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-white/45 sm:flex-row sm:px-6">
      <p>&copy; {year} {SITE.name}. Todos os direitos reservados.</p>
      <p>Fotografia de casamento &middot; {SITE.city} &amp; região</p>
    </div>
  </div>
</footer>