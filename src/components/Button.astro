---
/**
 * Botão e link de ação.
 *
 * Havia quatro variantes de pill copiadas em `Hero`, `CTA`, `404` e a home,
 * todas com o mesmo `rounded-full px-7 py-3.5` — e cada uma mantendo o seu
 * próprio par de cores de hover. Quando o hover do botão primário mudou de tom,
 * três dos quatro ficaram para trás.
 *
 * `href` decide o elemento: com href sai `<a>`, sem href sai `<button>`. Isso
 * importa para acessibilidade e para o comportamento padrão do teclado.
 */
type Variant = 'primary' | 'secondary' | 'on-ink' | 'ghost';
type Size = 'md' | 'lg';

interface Props {
  href?: string;
  /** Sem href, o componente vira `<button>` e espera `type`. */
  type?: 'button' | 'submit';
  variant?: Variant;
  size?: Size;
  /** Abre em nova aba já com `rel="noopener"`. */
  external?: boolean;
  prefetch?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  external = false,
  prefetch = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const VARIANTS: Record<Variant, string> = {
  // O hover vai para `--color-accent-strong` (6.74 sob branco). O tom antigo
  // (`accent-soft`, #b98b60) dava 3.03 sob branco — abaixo de 4.5:1.
  primary: 'bg-accent text-white hover:bg-accent-strong',
  secondary: 'border border-line bg-surface text-text hover:border-accent hover:text-accent',
  // Sobre fotografia ou `bg-ink` o botão precisa da borda clara: a `border-line`
  // (1.20:1) desaparece em cima de uma imagem escura.
  'on-ink':
    'border border-white/45 text-white backdrop-blur-sm hover:border-white hover:bg-white/10',
  ghost: 'border border-current/40 text-current hover:border-current hover:bg-current/10',
};

const SIZES: Record<Size, string> = {
  md: 'px-7 py-3.5 text-sm',
  lg: 'px-8 py-4 text-base',
};

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full font-medium',
  'transition-colors duration-200 ease-editorial',
  'motion-reduce:transition-none',
  VARIANTS[variant],
  SIZES[size],
  className,
];
---

<Tag
  class:list={classes}
  {...(href ? { href } : { type })}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...(href && prefetch ? { 'data-astro-prefetch': true } : {})}
  {...rest}
>
  <slot />
</Tag>
