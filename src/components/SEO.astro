---
import { SITE, absolute, canonicalPath } from '../site.config';
import { OG_HEIGHT, OG_WIDTH, ogImageFrom } from '../utils/og';

import portrait from '../assets/profile.png';

interface Props {
  /** <title> da página — sem o nome do site */
  title: string;
  /** Meta description (120–160 chars) */
  description: string;
  /**
   * Caminho (ou URL absoluta). Default: página atual.
   * `false` omite a tag — a página 404 é servida pelo Cloudflare em qualquer
   * URL ausente, então não existe um endereço canônico para ela.
   */
  canonical?: string | false;
  /**
   * Imagem para Open Graph (caminho ou URL). Sem ela, usa o retrato do
   * fotógrafo: quem compartilha uma página que não é um casamento quer ver
   * quem assina o trabalho, não uma foto de outro casal.
   */
  ogImage?: string;
  /** Dimensões da og:image. Redes só reservam o card se forem explícitas. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Texto alternativo da og:image (padrão: description) */
  ogImageAlt?: string;
  /** Tipo Open Graph. Default: website */
  type?: 'website' | 'article';
  /** article:published_time / article:modified_time (ISO 8601) */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** article:author e article:section */
  author?: string;
  section?: string;
  /** JSON-LD como objeto serializável */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Impede indexação (páginas privadas / 404) */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  jsonLd,
  noindex = false,
} = Astro.props;

const resolvedCanonical = canonical === false ? null : absolute(canonicalPath(canonical));

// Só entra no pipeline de imagem quando a página não traz a sua própria — as
// páginas de casamento e de post já passam a capa, e reprocessar o retrato
// nelas só gastaria build.
const defaultOg = ogImage ? undefined : await ogImageFrom(portrait);
const resolvedOgImage = absolute(ogImage ?? defaultOg!.src);

// As dimensões precisam ser as do arquivo, não as constantes do Open Graph: o
// retrato dá 1080x567 e anunciar 1200x630 faz o scraper reservar um card maior
// do que a imagem que ele vai encontrar.
const resolvedOgWidth = ogImageWidth ?? defaultOg?.width ?? OG_WIDTH;
const resolvedOgHeight = ogImageHeight ?? defaultOg?.height ?? OG_HEIGHT;

const DEFAULT_OG_TITLE = `${SITE.name} — ${SITE.role}`;

/**
 * O título do conteúdo é o `excerpt` (nos casamentos) ou o `title` (no blog),
 * não um `seoTitle` separado. Nenhum dos dois traz marca hoje, mas o
 * aparelho de paginação reaproveita `title` em strings onde o autor pode
 * ter escrito `| Fotografia`: anexar `| Rafael Dias - Fotos` depois disso
 * geraria duas marcas e o Google truncaria no meio da segunda.
 *
 * Corta qualquer sufixo que já identifique a marca antes de anexar o nome do
 * site, para o resultado final ter um sufixo só.
 */
const BRAND_SUFFIX = /(\s*\|\s*[^|]*(?:fotografia|fotos?|dias|composi[cç][aã]o)[^|]*)+$/i;

const stripped = title.replace(BRAND_SUFFIX, '').trim() || title;

const FULL_TITLE =
  stripped === SITE.name || title === DEFAULT_OG_TITLE
    ? SITE.name
    : `${stripped} | ${SITE.name}`;

/**
 * Sem isso, todas as páginas não-article compartilhavam o mesmo og:title e o
 * preview no WhatsApp/Facebook ficava genérico ("Rafael Dias - Fotos —
 * Fotógrafo de casamento"), sem indicar qual página era. Só a home precisa do
 * título padrão.
 */
const OG_TITLE = FULL_TITLE === SITE.name ? DEFAULT_OG_TITLE : FULL_TITLE;

const imageAlt = ogImageAlt ?? description;
const isArticle = type === 'article';

/**
 * MIME pela extensão da URL. O LinkedIn e o Facebook usam `og:image:type` para
 * decidir se baixam a imagem; sem ele, alguns scrapers caem no default e
 * recusam a renderização do card.
 */
const OG_IMAGE_TYPES: Record<string, string> = {
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.png': 'image/png',
  '.webp': 'image/webp',
  '.gif': 'image/gif',
};

const ogImageExt = (() => {
  const path = resolvedOgImage.split('?')[0];
  const dot = path.lastIndexOf('.');
  return dot === -1 ? '' : path.slice(dot).toLowerCase();
})();
const ogImageType = OG_IMAGE_TYPES[ogImageExt];
---

<title>{FULL_TITLE}</title>
<meta name="description" content={description} />
{resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<meta name="generator" content={Astro.generator} />

{/* Theme / mobile */}
<meta name="theme-color" content="#16120e" />
<meta name="color-scheme" content="light" />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={OG_TITLE} />
<meta property="og:description" content={description} />
{resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
<meta property="og:image" content={resolvedOgImage} />
{/* `secure_url` é a mesma URL: o site é https e o preview é gerado em contexto seguro. */}
{resolvedOgImage.startsWith('https://') && (
  <meta property="og:image:secure_url" content={resolvedOgImage} />
)}
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.locale} />
{
  resolvedOgWidth && resolvedOgHeight ? (
    <>
      <meta property="og:image:width" content={String(resolvedOgWidth)} />
      <meta property="og:image:height" content={String(resolvedOgHeight)} />
    </>
  ) : null
}

{/* Open Graph — article. Sem isto o card não mostra a data do post. */}
{
  isArticle ? (
    <>
      {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
      {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
      {author && <meta property="article:author" content={author} />}
      {section && <meta property="article:section" content={section} />}
    </>
  ) : null
}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={OG_TITLE} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={imageAlt} />
{resolvedOgWidth && <meta name="twitter:image:width" content={String(resolvedOgWidth)} />}
{resolvedOgHeight && <meta name="twitter:image:height" content={String(resolvedOgHeight)} />}

{/* Favicon */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{/* Manifest / precarga de recurso crítico */}
<link rel="manifest" href="/site.webmanifest" />
{
  jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null
}
