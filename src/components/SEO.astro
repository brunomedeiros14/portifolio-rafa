---
import { SITE, absolute } from '../site.config';

interface Props {
  /** <title> da página — sem o nome do site */
  title: string;
  /** Meta description (120–160 chars) */
  description: string;
  /** Caminho (ou URL absoluta). Default: página atual */
  canonical?: string;
  /** Imagem para Open Graph (caminho ou URL) */
  ogImage?: string;
  /** Dimensões da og:image. Redes só reservam o card se forem explícitas. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Texto alternativo da og:image (padrão: description) */
  ogImageAlt?: string;
  /** Tipo Open Graph. Default: website */
  type?: 'website' | 'article';
  /** article:published_time / article:modified_time (ISO 8601) */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** article:author e article:section */
  author?: string;
  section?: string;
  /** JSON-LD como objeto serializável */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Impede indexação (páginas privadas / 404) */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = '/og-default.jpg',
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  jsonLd,
  noindex = false,
} = Astro.props;

const resolvedCanonical = absolute(canonical);
const resolvedOgImage = absolute(ogImage);

const DEFAULT_OG_TITLE = `${SITE.name} — ${SITE.role}`;
const FULL_TITLE = title === SITE.name || title === DEFAULT_OG_TITLE ? SITE.name : `${title} | ${SITE.name}`;

/**
 * Sem isso, todas as páginas não-article compartilhavam o mesmo og:title e o
 * preview no WhatsApp/Facebook ficava genérico ("Rafael Dias - Fotos —
 * Fotógrafo de casamento"), sem indicar qual página era. Só a home precisa do
 * título padrão.
 */
const OG_TITLE = FULL_TITLE === SITE.name ? DEFAULT_OG_TITLE : FULL_TITLE;

const imageAlt = ogImageAlt ?? description;
const isArticle = type === 'article';
---

<title>{FULL_TITLE}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />

<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<meta name="generator" content={Astro.generator} />

{/* Theme / mobile */}
<meta name="theme-color" content="#16120e" />
<meta name="color-scheme" content="light" />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={OG_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.locale} />
{
  ogImageWidth && ogImageHeight ? (
    <>
      <meta property="og:image:width" content={String(ogImageWidth)} />
      <meta property="og:image:height" content={String(ogImageHeight)} />
    </>
  ) : null
}

{/* Open Graph — article. Sem isto o card não mostra a data do post. */}
{
  isArticle ? (
    <>
      {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
      {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
      {author && <meta property="article:author" content={author} />}
      {section && <meta property="article:section" content={section} />}
    </>
  ) : null
}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={OG_TITLE} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{/* Favicon */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{/* Manifest / precarga de recurso crítico */}
<link rel="manifest" href="/site.webmanifest" />
{
  jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null
}
