---
interface Props {
  /** Mesmo id do container da galeria. */
  id: string;
}

const { id } = Astro.props;
---

<dialog
  id={`lightbox-${id}`}
  data-gallery-target={id}
  class="lb m-0 h-full max-h-none w-full max-w-none border-0 bg-ink/92 p-0 text-white backdrop:bg-ink/80"
  aria-label="Visualizador de fotografias"
>
  <button
    type="button"
    class="lb-close absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white/10"
    data-lb-close
    aria-label="Fechar visor (tecla Esc)"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
    </svg>
  </button>

  <figure class="flex h-full flex-col items-center justify-center gap-4 px-4 py-16 sm:px-16">
    <div class="lb-stage flex min-h-0 items-center justify-center">
      <img
        class="lb-img max-h-[78vh] max-w-full rounded-sm object-contain"
        alt=""
      />
    </div>
    <figcaption class="flex flex-col items-center gap-1 px-2 text-center text-sm text-white/70">
      <span class="lb-caption" aria-live="polite"></span>
      <span class="text-xs text-white/45" data-lb-counter aria-hidden="true"></span>
    </figcaption>
  </figure>

  <button
    type="button"
    class="lb-prev absolute left-3 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white/10 sm:left-5"
    data-lb-prev
    style="visibility: hidden"
    aria-label="Foto anterior (seta esquerda)"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button
    type="button"
    class="lb-next absolute right-3 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white/10 sm:right-5"
    data-lb-next
    style="visibility: hidden"
    aria-label="Próxima foto (seta direita)"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</dialog>

<style is:global>
  dialog.lb {
    overscroll-behavior: contain;
  }

  dialog.lb[open] {
    animation: lb-fade 240ms ease;
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { initLightbox } from '../scripts/lightbox';
  import { onPageLoad } from '../scripts/lifecycle';

  onPageLoad(initLightbox);
</script>
