---
import { SITE } from '../site.config';
import Icon from './Icon.astro';

interface Props {
  /** Esconde em páginas onde já há um CTA de contato no topo. */
  hideOn?: string[];
}

const { hideOn = [] } = Astro.props;

/**
 * `trailingSlash: 'ignore'` no astro.config faz o build emitir `/contato/`, e
 * `hideOn` é escrito como `/contato`. Comparar direto nunca bateria e o botão
 * aparecia também onde já existe um CTA de contato.
 */
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const current = normalize(Astro.url.pathname);

const shouldRender = !hideOn.some((path) => normalize(path) === current);
const label = 'Chamar no WhatsApp';
---

{
  shouldRender ? (
    <a
      href={SITE.whatsappUrl}
      target="_blank"
      rel="noopener"
      aria-label={`${label} — ${SITE.whatsapp}`}
      class="group fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-white shadow-lg shadow-ink/20 transition-transform duration-300 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:bottom-8 md:right-8"
    >
      <Icon
        name="whatsapp"
        size={26}
        class="transition-transform duration-300 group-hover:scale-110 motion-reduce:transition-none"
      />
    </a>
  ) : null
}
