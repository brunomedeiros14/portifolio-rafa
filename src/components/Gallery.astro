---
import { Picture } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import type { GalleryItem } from '../utils/weddings';

interface Props {
  /** Deve ser único na página. */
  id: string;
  items: GalleryItem[];
}

const { id, items } = Astro.props;
---

<div id={id} class="columns-2 gap-3 sm:gap-4 lg:columns-3">
  {items.map((item, index) => (
    <figure class="mb-3 break-inside-avoid sm:mb-4">
      <button
        type="button"
        class="group relative block w-full cursor-zoom-in overflow-hidden rounded-sm bg-line"
        data-lightbox-item
        data-gallery={id}
        data-index={index}
        data-src={item.image.src}
        data-width={item.image.width}
        data-height={item.image.height}
        data-caption={item.caption}
        aria-label={`Ampliar foto: ${item.caption}`}
      >
        <Picture
          src={item.image}
          alt={item.caption}
          widths={[480, 1024]}
          sizes="(min-width: 1280px) 384px, (min-width: 1024px) 31vw, (min-width: 640px) 48vw, 96vw"
          formats={['avif']}
          fallbackFormat="avif"
          loading="lazy"
          decoding="async"
          class="w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      </button>
      <figcaption class="sr-only">{item.caption}</figcaption>
    </figure>
  ))}
</div>

<Lightbox id={id} />