---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface CTA {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctas?: CTA[];
  /** LCP — carrega com prioridade e sem lazy. */
  priority?: boolean;
}

const {
  image,
  alt,
  eyebrow,
  title,
  subtitle,
  ctas = [],
  priority = true,
} = Astro.props;
---

<section class="relative flex min-h-[92svh] items-end overflow-hidden bg-ink">
  <Picture
    src={image}
    alt={alt}
    widths={[1280, 1920]}
    sizes="100vw"
    formats={['avif']}
    fallbackFormat="avif"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-linear-to-t from-ink/85 via-ink/25 to-ink/10" aria-hidden="true" />
  <div class="absolute inset-x-0 top-0 h-44 bg-linear-to-b from-ink/75 via-ink/35 to-transparent" aria-hidden="true" />

  <div class="relative mx-auto w-full max-w-(--content-max) px-4 pb-16 pt-40 sm:px-6 md:pb-20">
    {eyebrow ? (
      <p class="reveal text-xs font-medium uppercase tracking-[0.28em] text-white/75">{eyebrow}</p>
    ) : null}
    <h1 class="reveal mt-4 max-w-3xl font-display text-4xl font-medium leading-[1.04] tracking-tight text-white sm:text-5xl md:text-6xl" style="--reveal-delay:80ms">
      {title}
    </h1>
    {subtitle ? (
      <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg" style="--reveal-delay:160ms">
        {subtitle}
      </p>
    ) : null}
    {ctas.length > 0 ? (
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay:240ms">
        {ctas.map((cta) =>
          cta.primary ? (
            <a
              href={cta.href}
              class="inline-flex items-center justify-center rounded-full bg-accent px-7 py-3.5 text-sm font-medium text-white transition-colors hover:bg-accent-soft"
            >
              {cta.label}
            </a>
          ) : (
            <a
              href={cta.href}
              class="inline-flex items-center justify-center rounded-full border border-white/45 px-7 py-3.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white hover:bg-white/10"
            >
              {cta.label}
            </a>
          ),
        )}
      </div>
    ) : null}
  </div>
</section>