---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import Reveal from './Reveal.astro';

interface CTA {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctas?: CTA[];
  /** LCP — carrega com prioridade e sem lazy. */
  priority?: boolean;
}

const { image, alt, eyebrow, title, subtitle, ctas = [], priority = true } = Astro.props;
---

<section class="relative flex min-h-[92svh] items-end overflow-hidden bg-ink">
  <Picture
    src={image}
    alt={alt}
    widths={[1280, 1920]}
    sizes="100vw"
    formats={['avif', 'webp']}
    fallbackFormat="webp" /* fallback de JPEG para JPEG em webp — ver Gallery.astro */
    width={1920}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-ink/85 via-ink/25 to-ink/10"
    aria-hidden="true"
  />
  <div
    class="absolute inset-x-0 top-0 h-44 bg-linear-to-b from-ink/75 via-ink/35 to-transparent"
    aria-hidden="true"
  />

  <div class="relative mx-auto w-full max-w-(--content-max) px-(--gutter) pt-40 pb-16 md:pb-20">
    {eyebrow ? <Eyebrow onInk>{eyebrow}</Eyebrow> : null}
    <Reveal
      as="h1"
      delay={80}
      class="mt-4 max-w-3xl font-display text-4xl leading-[1.04] font-medium tracking-tight text-white sm:text-5xl md:text-6xl"
    >
      {title}
    </Reveal>
    {subtitle ? (
      <Reveal
        as="p"
        delay={160}
        class="mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg"
      >
        {subtitle}
      </Reveal>
    ) : null}
    {ctas.length > 0 ? (
      <Reveal class="mt-8 flex flex-wrap gap-4" delay={240}>
        {ctas.map((cta) => (
          <Button href={cta.href} variant={cta.primary ? 'primary' : 'on-ink'}>
            {cta.label}
          </Button>
        ))}
      </Reveal>
    ) : null}
  </div>
</section>
