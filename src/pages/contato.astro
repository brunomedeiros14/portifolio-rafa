---
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absolute } from '../site.config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato',
  url: absolute('/contato'),
  provider: { '@type': 'Person', name: SITE.name, email: SITE.email, telephone: SITE.whatsapp },
};
---

<BaseLayout
  title="Contato"
  description="Vamos conversar sobre o seu casamento? Fale com Rafael Dias pelo WhatsApp, e-mail ou Instagram e descubra como fotografar a sua história."
  jsonLd={jsonLd}
  headerTransparent={false}
>
  <main class="bg-background">
    <header class="border-b border-line">
      <div class="mx-auto max-w-(--content-max) px-4 pb-14 pt-[calc(var(--header-h)+2rem)] sm:px-6 md:pb-18">
        <p class="reveal text-xs font-medium uppercase tracking-[0.24em] text-accent">Contato</p>
        <h1 class="reveal mt-3 max-w-3xl font-display text-4xl font-medium tracking-tight sm:text-5xl">
          Vamos conversar sobre o seu casamento?
        </h1>
        <p class="reveal mt-5 max-w-2xl text-base leading-relaxed text-muted" style="--reveal-delay:120ms">
          Me conte a data, o lugar e quem vocês são. Respondo pessoalmente, com calma e sem
          compromisso — o primeiro passo é só uma conversa.
        </p>
      </div>
    </header>

    <section class="mx-auto max-w-(--content-max) px-4 py-16 sm:px-6 md:py-20">
      <div class="grid gap-6 md:grid-cols-3">
        <a
          href={SITE.whatsappUrl}
          target="_blank"
          rel="noopener"
          class="reveal group flex flex-col justify-between rounded-sm border border-line bg-surface p-8 transition-colors hover:border-accent"
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Mais rápido</p>
            <h2 class="mt-3 font-display text-2xl font-medium tracking-tight">WhatsApp</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{SITE.whatsapp}</p>
          </div>
          <p class="mt-8 text-sm font-medium text-accent transition-transform group-hover:translate-x-1">
            Chamar agora →
          </p>
        </a>

        <a
          href={`mailto:${SITE.email}?subject=${encodeURIComponent('Dúvida sobre fotografia de casamento')}`}
          class="reveal group flex flex-col justify-between rounded-sm border border-line bg-surface p-8 transition-colors hover:border-accent"
          style="--reveal-delay:80ms"
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-accent">E-mail</p>
            <h2 class="mt-3 font-display text-2xl font-medium tracking-tight">Escreva</h2>
            <p class="mt-3 break-all text-sm leading-relaxed text-muted">{SITE.email}</p>
          </div>
          <p class="mt-8 text-sm font-medium text-accent transition-transform group-hover:translate-x-1">
            Enviar e-mail →
          </p>
        </a>

        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener"
          class="reveal group flex flex-col justify-between rounded-sm border border-line bg-surface p-8 transition-colors hover:border-accent"
          style="--reveal-delay:160ms"
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Instagram</p>
            <h2 class="mt-3 font-display text-2xl font-medium tracking-tight">Acompanhe</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{SITE.instagramHandle}</p>
          </div>
          <p class="mt-8 text-sm font-medium text-accent transition-transform group-hover:translate-x-1">
            Visitar perfil →
          </p>
        </a>
      </div>
    </section>

    <section class="bg-surface py-16">
      <div class="mx-auto max-w-(--content-max) px-4 sm:px-6">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
          <div>
            <h2 class="font-display text-2xl font-medium tracking-tight sm:text-3xl">
              O que acontece depois do contato?
            </h2>
            <ol class="mt-6 space-y-4 text-sm text-muted">
              {[
                'Respondo em até 24 horas úteis',
                'Trocamos ideias sobre data, lugar e estilo',
                'Agendamos uma conversa (presencial ou online)',
                'Você recebe uma proposta clara e sem pressão',
              ].map((item, index) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-display text-xs italic text-accent">
                    {index + 1}
                  </span>
                  {item}
                </li>
              ))}
            </ol>
          </div>
          <div class="flex flex-col items-start gap-6 rounded-sm bg-ink p-8 md:p-10">
            <p class="text-sm text-white/70">Encontre a gente em todos os lugares:</p>
            <SocialLinks size={26} tone="light" />
            <p class="pt-4 text-xs text-white/45">{SITE.city}, {SITE.state} — atendemos todo o Brasil</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>