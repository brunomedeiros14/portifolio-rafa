---
import Eyebrow from '../components/Eyebrow.astro';
import PageHeader from '../components/PageHeader.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absolute, canonicalPath } from '../site.config';

const CHANNELS = [
  {
    channel: 'whatsapp',
    eyebrow: 'Mais rápido',
    title: 'WhatsApp',
    detail: SITE.whatsapp,
    cta: 'Chamar agora',
    href: SITE.whatsappUrl,
    external: true,
  },
  {
    channel: 'email',
    eyebrow: 'E-mail',
    title: 'Escreva',
    detail: SITE.email,
    cta: 'Enviar e-mail',
    href: `mailto:${SITE.email}?subject=${encodeURIComponent('Dúvida sobre fotografia de casamento')}`,
    break: true,
  },
  {
    channel: 'instagram',
    eyebrow: 'Instagram',
    title: 'Acompanhe',
    detail: SITE.instagramHandle,
    cta: 'Visitar perfil',
    href: SITE.instagram,
    external: true,
  },
];

const AFTER_CONTACT = [
  'Respondo em até 24 horas úteis',
  'Trocamos ideias sobre data, lugar e estilo',
  'Agendamos uma conversa (presencial ou online)',
  'Você recebe uma proposta clara e sem pressão',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato',
  url: absolute(canonicalPath('/contato')),
  provider: { '@type': 'Person', name: SITE.name, email: SITE.email, telephone: SITE.whatsapp },
};
---

<BaseLayout
  title="Contato"
  description="Vamos conversar sobre o seu casamento? Fale com Rafael Dias pelo WhatsApp, e-mail ou Instagram e descubra como fotografar a sua história."
  jsonLd={jsonLd}
  headerTransparent={false}
>
  <PageHeader
    eyebrow="Contato"
    title="Vamos conversar sobre o seu casamento?"
    description="Me conte a data, o lugar e quem vocês são. Respondo pessoalmente, com calma e sem compromisso — o primeiro passo é só uma conversa."
  />

  {/*
    O WhatsApp ocupa a faixa inteira e o e-mail/Instagram dividem a de baixo.

    Três cartões iguais punham no mesmo peso um canal que fecha conversa em
    minutos e um perfil que só é consultado de vez em quando. A ordem importa:
    é a ordem em que alguém de fato tenta falar, e o WhatsApp é onde a maioria
    dos casais começa.
  */}
  <Section rhythm="page">
    <Reveal>
      <a
        href={SITE.whatsappUrl}
        target="_blank"
        rel="noopener"
        class="group block border border-line bg-surface p-8 transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:p-10"
      >
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <Eyebrow>Canal mais direto</Eyebrow>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">
              Chame no WhatsApp
            </h2>
            <p class="mt-4 max-w-lg text-sm leading-relaxed text-muted">
              É o canal mais rápido e o que eu prefiro. Me conte a data, a cidade e o que mais
              importa para vocês — respondo em até 24 horas úteis.
            </p>
          </div>
          <p class="font-display text-2xl text-accent transition-transform group-hover:translate-x-1 sm:text-3xl">
            {SITE.whatsapp} <span aria-hidden="true">→</span>
          </p>
        </div>
      </a>
    </Reveal>

    <ul class="mt-6 grid gap-6 sm:grid-cols-2">
      {CHANNELS.filter((channel) => channel.channel !== 'whatsapp').map((channel, index) => (
        <Reveal as="li" delay={index * 80}>
          <a
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener' : undefined}
            class="group flex h-full flex-col justify-between rounded-sm border border-line bg-surface p-8 transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <div>
              <Eyebrow>{channel.eyebrow}</Eyebrow>
              <h2 class="mt-3 font-display text-2xl font-medium tracking-tight">{channel.title}</h2>
              <p
                class:list={[
                  'mt-3 text-sm leading-relaxed text-muted',
                  channel.break && 'break-all',
                ]}
              >
                {channel.detail}
              </p>
            </div>
            <p class="mt-8 text-sm font-medium text-accent transition-transform group-hover:translate-x-1">
              {channel.cta} <span aria-hidden="true">→</span>
            </p>
          </a>
        </Reveal>
      ))}
    </ul>
  </Section>

  <Section tone="surface" rhythm="tight">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <h2 class="font-display text-2xl font-medium tracking-tight sm:text-3xl">
          O que acontece depois do contato?
        </h2>
        <ol class="mt-8">
          {AFTER_CONTACT.map((item, index) => (
            <li class="flex items-baseline gap-5 border-t border-line py-4 text-sm leading-relaxed text-muted">
              <span class="font-display text-sm text-accent/70 italic" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col items-start gap-6 rounded-sm bg-ink p-8 text-white md:col-span-4 md:col-start-9 md:p-10">
        <p class="text-sm text-white/70">Acompanhe o trabalho por aqui:</p>
        <SocialLinks size={26} tone="light" />
        <p class="pt-4 text-xs text-white/45">
          {SITE.city}, {SITE.state} — atendemos todo o Brasil
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
