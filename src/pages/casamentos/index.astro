---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import WeddingGrid from '../../components/WeddingGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absolute, canonicalPath } from '../../site.config';
import { ID, node } from '../../utils/schema';
import { ogImageFrom } from '../../utils/og';

const weddings = await getCollection('weddings', ({ data }) => !data.draft);

const ogBySlug = Object.fromEntries(
  await Promise.all(
    weddings.map(async ({ data }) => [data.slug, (await ogImageFrom(data.cover)).src]),
  ),
);

/**
 * `hasPart` com `Article` não descreve uma lista navegável. `ItemList` é o tipo
 * que o Google usa para gerar o rich result de " carousel"/lista, e cada item
 * precisa de `position` para ordenar.
 */
const jsonLd = node({
  '@type': 'CollectionPage',
  name: 'Casamentos',
  description:
    'Casamentos fotografados por Rafael Dias em Belo Horizonte, Nova Lima, Ouro Preto, Tiradentes e por todo Minas Gerais.',
  url: absolute(canonicalPath('/casamentos')),
  isPartOf: { '@id': ID.website },
  provider: { '@id': ID.person },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Casamentos fotografados',
    numberOfItems: weddings.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: weddings.map(({ data }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(`/casamentos/${data.slug}`),
      item: {
        '@type': 'Article',
        '@id': absolute(`/casamentos/${data.slug}#article`),
        headline: `${data.couple} — casamento em ${data.city}`,
        description: data.excerpt,
        url: absolute(`/casamentos/${data.slug}`),
        datePublished: data.date.toISOString().slice(0, 10),
        thumbnailUrl: absolute(ogBySlug[data.slug]!),
        author: { '@id': ID.person },
      },
    })),
  },
});
---

<BaseLayout
  title="Casamentos"
  description="Histórias reais de casamento fotografadas por Rafael Dias em Belo Horizonte, Nova Lima, Ouro Preto, Tiradentes e por todo Minas Gerais."
  headerTransparent={false}
  jsonLd={jsonLd}
>
  <header class="border-b border-line bg-background">
    <div class="mx-auto max-w-(--content-max) px-4 pt-[calc(var(--header-h)+2rem)] sm:px-6">
      <Breadcrumbs items={[{ label: 'Casamentos' }]} />
    </div>
    <div class="mx-auto max-w-(--content-max) px-4 pb-16 pt-10 sm:px-6 md:pb-20">
      <p class="reveal text-xs font-medium uppercase tracking-[0.24em] text-accent">Portfólio</p>
      <h1
        class="reveal mt-3 max-w-3xl font-display text-4xl font-medium tracking-tight sm:text-5xl"
        style="--reveal-delay:80ms"
      >
        Cada casamento, uma história
      </h1>
      <p
        class="reveal mt-5 max-w-2xl text-base leading-relaxed text-muted"
        style="--reveal-delay:160ms"
      >
        Uma curadoria das cerimônias que tive o privilégio de fotografar. {weddings.length}{' '}
        histórias completas — e cada uma com galeria, bastidores e lugares reais de Minas Gerais.
      </p>
      {/* Os cartões são <h3> (nome do casal). Sem um <h2> intermediário a
          hierarquia saltava de h1 para h3, e o outline do leitor de tela
          apresentava os casamentos como se fossem subseções do <h1> — o que
          eles não são. */}
      <h2 class="sr-only">Casamentos fotografados</h2>
    </div>
  </header>

  <div class="bg-surface">
    <div class="mx-auto max-w-(--content-max) px-4 py-16 sm:px-6 md:py-20">
      <WeddingGrid weddings={weddings} priorityFirst />
    </div>
  </div>

  <CTA />
</BaseLayout>
