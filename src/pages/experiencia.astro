---
import CTA from '../components/CTA.astro';
import PageHeader from '../components/PageHeader.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatTile from '../components/StatTile.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const STEPS = [
  {
    num: '01',
    title: 'Primeiro contato',
    text: 'Vocês me chamam pelo WhatsApp ou e-mail e me contam o sonho: data, lugar, tamanho da festa, o que mais importa. Respondo pessoalmente — sem robô.',
  },
  {
    num: '02',
    title: 'Encontro',
    text: 'Marcamos uma conversa (presencial ou online) e eu mostro histórias completas de casamentos reais, com tudo que correu bem e o que eu teria feito diferente.',
  },
  {
    num: '03',
    title: 'Proposta',
    text: 'Vocês recebem uma proposta clara com cobertura, número de fotos, prazo, autorização de uso e valor. Sem letra miúda — e dou tempo para decidirem.',
  },
  {
    num: '04',
    title: 'Preparação',
    text: 'Conversamos sobre cronograma, ensaio pré-wedding opcional e o mapa de lugares do dia. Eu chego sempre antes, com plano A, B e C para luz e chuva.',
  },
  {
    num: '05',
    title: 'O grande dia',
    text: 'Cobertura discreta e completa. O objetivo é que vocês vivam o dia por inteiro — enquanto eu guardo cada parte dele.',
  },
  {
    num: '06',
    title: 'Entrega',
    text: 'Curadoria e edição em até 60 dias. Álbum digital completo + seleção para impressão, em alta resolução, com liberação de uso total.',
  },
];

const DELIVERABLES = [
  { value: '50+', detail: 'fotografias por hora de cobertura, o quanto a história pedir' },
  { value: '100%', detail: 'das fotos com edição individual de luz e cor' },
  { value: '30 dias', detail: 'prazo de entrega com curadoria em alta resolução' },
  { value: 'Uso total', detail: 'para imprimir, publicar e guardar para sempre' },
];
---

<BaseLayout
  title="Experiência"
  description="Como funciona contratar a fotografia do seu casamento com Rafael Dias: do primeiro contato à entrega do álbum, um processo claro e transparente."
  headerTransparent={false}
>
  <PageHeader
    eyebrow="Experiência"
    title="Um processo simples, de mãos dadas"
    description="Desde o primeiro contato até a noite em que vocês abrirem o álbum em casa, vocês sabem exatamente o esperar."
  />

  {/*
    O título fica numa coluna que acompanha a rolagem enquanto as seis etapas
    descem. Antes, tudo em uma coluna: a pessoa lia as seis etapas inteiras antes
    de saber o que era a seção, e a página ocupava uma tela inteira para
    processar seis parágrafos.
  */}
  <Section rhythm="page">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <div class="md:sticky md:top-28">
          <SectionHeading
            eyebrow="Do começo ao fim"
            title="Seis etapas, sem surpresa"
            headingId="etapas-heading"
          />
          <p class="mt-6 text-sm leading-relaxed text-muted">
            Nada aqui depende de sorte ou de improviso. Cada etapa tem um momento, um combinado e um
            prazo — e eu aviso quando alguma coisa muda.
          </p>
        </div>
      </div>

      <ol class="md:col-span-7 md:col-start-6" aria-labelledby="etapas-heading">
        {STEPS.map((step) => (
          <Reveal
            as="li"
            class="grid gap-4 border-t border-line py-8 sm:grid-cols-[4rem_1fr] sm:gap-8"
          >
            <p class="font-display text-3xl leading-none text-accent/40 italic">{step.num}</p>
            <div>
              <h2 class="font-display text-xl font-medium tracking-tight sm:text-2xl">
                {step.title}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{step.text}</p>
            </div>
          </Reveal>
        ))}
        <li aria-hidden="true" class="border-t border-line" />
      </ol>
    </div>
  </Section>

  <Section tone="surface">
    <SectionHeading
      eyebrow="Entregáveis"
      title="O que você recebe"
      description="O mesmo contrato em todo casamento — sem pacote escondido, sem taxa de uso."
      align="center"
    />
    <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {/* Sem `border-t` no <li>: o fio do topo é do `StatTile`, e repetir aqui
          desenhava dois. */}
      {DELIVERABLES.map((item, index) => (
        <Reveal as="li" delay={index * 80}>
          <StatTile {...item} />
        </Reveal>
      ))}
    </ul>
  </Section>

  <CTA title="Quer saber se temos agenda livre?" />
</BaseLayout>
