---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import { SITE, absolute, formatDate } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  ...(data.cover
    ? { image: [absolute(data.cover.src)] }
    : {}),
  datePublished: data.date.toISOString(),
  ...(data.updated ? { dateModified: data.updated.toISOString() } : {}),
  author: { '@type': 'Person', name: data.author },
  publisher: { '@type': 'Person', name: SITE.name },
  ...(data.canonical ? { mainEntityOfPage: data.canonical } : {}),
};
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  canonical={`/blog/${data.slug}`}
  ogImage={data.cover?.src}
  type="article"
  jsonLd={data.canonical ? undefined : jsonLd}
  headerTransparent={Boolean(data.cover)}
>
  <article>
    {data.cover ? (
      <header class="relative flex min-h-[58svh] items-end overflow-hidden bg-ink">
        <Picture
          src={data.cover}
          alt={data.description}
          widths={[1280, 1920]}
          sizes="100vw"
          formats={['avif']}
          fallbackFormat="avif"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-ink/10" aria-hidden="true" />
        <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-ink/75 via-ink/35 to-transparent" aria-hidden="true" />
        <div class="relative mx-auto w-full max-w-3xl px-4 pb-14 pt-40 sm:px-6">
          <Breadcrumbs
            items={[{ label: 'Blog', href: '/blog' }, { label: data.title }]}
          />
        </div>
      </header>
    ) : null}

    <div class="bg-background">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class={data.cover ? 'pt-10' : 'pt-[calc(var(--header-h)+2rem)]'}>
          {data.cover ? null : (
            <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: data.title }]} />
          )}
          <div class={data.cover ? 'mb-4' : 'mb-4 mt-8'}>
            {data.tags.length > 0 ? (
              <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">
                {data.tags.join(' · ')}
              </p>
            ) : null}
            <h1 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl md:text-[2.75rem]">
              {data.title}
            </h1>
            <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
              <span>{data.author}</span>
              <span aria-hidden="true" class="text-text/25">·</span>
              <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
              {data.updated ? (
                <>
                  <span aria-hidden="true" class="text-text/25">·</span>
                  <span>atualizado em {formatDate(data.updated)}</span>
                </>
              ) : null}
            </p>
          </div>
        </div>

        <div class="story border-t border-line pt-8 pb-20">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <CTA title="Gostou? Vamos conversar sobre o seu casamento?" />
</BaseLayout>