---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ogImageFrom } from '../utils/og';
import { ID, node, publisherRef } from '../utils/schema';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import WeddingGrid from '../components/WeddingGrid.astro';
import { getWeddingImages, getGalleryItems, weddingFolder } from '../utils/weddings';
import { SITE, absolute, formatDate, canonicalPath } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  wedding: CollectionEntry<'weddings'>;
  related: Array<CollectionEntry<'weddings'>>;
}

const { wedding, related } = Astro.props;
const { data } = wedding;

const galleryImages = getWeddingImages(weddingFolder(wedding), data.cover);
const galleryItems = getGalleryItems(galleryImages, data.couple);
const ogImage = await ogImageFrom(data.cover);

const articleUrl = absolute(canonicalPath(`/casamentos/${data.slug}`));

const jsonLd = [
  node({
    '@type': 'Article',
    '@id': `${articleUrl}#article`,
    headline: data.seoTitle ?? `${data.couple} — casamento`,
    description: data.excerpt,
    url: articleUrl,
    image: [absolute(ogImage.src)],
    datePublished: data.date.toISOString(),
    author: { '@id': ID.person },
    publisher: { '@id': ID.person },
    isPartOf: { '@id': ID.website },
    keywords: data.tags.length ? data.tags.join(', ') : undefined,
    about: {
      '@type': 'Event',
      name: `Casamento de ${data.couple}`,
      location: `${data.location} - ${data.state}`,
      startDate: data.date.toISOString().slice(0, 10),
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      image: absolute(ogImage.src),
    },
  }),
  node({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Casamentos', item: absolute(canonicalPath('/casamentos')) },
      { '@type': 'ListItem', position: 3, name: data.couple, item: articleUrl },
    ],
  }),
  publisherRef(),
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.couple} — casamento em ${data.location} (${data.state})`}
  description={data.seoDescription ?? data.excerpt}
  canonical={`/casamentos/${data.slug}`}
  ogImage={ogImage.src}
  ogImageWidth={ogImage.width}
  ogImageHeight={ogImage.height}
  ogImageAlt={`${data.couple} — casamento em ${data.location}`}
  type="article"
  publishedTime={data.date}
  noindex={data.draft}
  author={SITE.name}
  jsonLd={jsonLd}
>
  <article>
    <Hero
      image={data.cover}
      alt={`${data.couple} — ${data.excerpt}`}
      eyebrow={`${data.location} · ${data.state}`}
      title={data.couple}
      ctas={[{ label: 'Ver a galeria', href: '#galeria', primary: true }, { label: 'Conheça o fotógrafo', href: '/sobre' }]}
    />

    <div class="bg-background">
      <div class="mx-auto max-w-(--content-max) px-4 py-10 sm:px-6">
        <Breadcrumbs items={[{ label: 'Casamentos', href: '/casamentos' }, { label: data.couple }]} />
      </div>
    </div>

    {/* Intro */}
    <section class="mx-auto max-w-3xl px-4 sm:px-6" aria-label="Sobre o casamento">
      <div class="reveal border-y border-line py-12 text-center sm:py-16">
        <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">
          {formatDate(data.date)}
        </p>
        <p class="mx-auto mt-6 max-w-xl font-display text-2xl font-normal leading-snug text-text sm:text-3xl">
          {data.description}
        </p>
      </div>
    </section>

    {/* Galeria editorial */}
    <section id="galeria" class="mx-auto max-w-(--content-max) px-4 pt-16 sm:px-6 sm:pt-20" aria-label="Galeria de fotos">
      <div class="reveal mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">Galeria</p>
          <h2 class="mt-2 font-display text-3xl font-medium tracking-tight sm:text-4xl">
            {data.couple} na íntegra
          </h2>
        </div>
        <p class="max-w-xs text-sm text-muted">{galleryImages.length} fotografias curadas</p>
      </div>
      <Gallery id={`galeria-${data.slug}`} items={galleryItems} />
    </section>

    {/* A galeria fecha a página; o CTA tem fundo escuro e precisa de ar acima. */}
    <div class="py-12 sm:py-16">
      <CTA title={`E agora, será o dia de ${data.couple === 'Laura e Diego' ? 'vocês como eles' : 'vocês'}?`} />
    </div>
  </article>

  {related.length > 0 ? (
    <section class="bg-background py-20">
      <div class="mx-auto max-w-(--content-max) px-4 sm:px-6">
        <div class="reveal mb-10 max-w-2xl">
          <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">Continue vendo</p>
          <h2 class="mt-2 font-display text-3xl font-medium tracking-tight sm:text-4xl">Mais casamentos</h2>
          <p class="mt-3 text-muted">Casamentos com clima e região parecidos com o de {data.couple}.</p>
        </div>
        <WeddingGrid weddings={related} />
      </div>
    </section>
  ) : null}
</BaseLayout>