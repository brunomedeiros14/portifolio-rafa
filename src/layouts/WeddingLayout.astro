---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import WeddingGrid from '../components/WeddingGrid.astro';
import { getWeddingImages, getGalleryItems, weddingFolder } from '../utils/weddings';
import { render } from 'astro:content';
import { SITE, absolute, formatDate } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  wedding: CollectionEntry<'weddings'>;
  related: Array<CollectionEntry<'weddings'>>;
}

const { wedding, related } = Astro.props;
const { data } = wedding;
const { Content } = await render(wedding);

const galleryImages = getWeddingImages(weddingFolder(wedding), data.cover);
const galleryItems = getGalleryItems(galleryImages, data.couple);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.seoTitle ?? `${data.couple} — casamento`,
    image: [absolute(data.cover.src)],
    datePublished: data.date.toISOString(),
    author: { '@type': 'Person', name: SITE.name },
    publisher: { '@type': 'Person', name: SITE.name },
    about: { '@type': 'Event', name: `Casamento de ${data.couple}`, location: `${data.location}, ${data.city} - ${data.state}`, startDate: data.date.toISOString().slice(0, 10), eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Casamentos', item: absolute('/casamentos') },
      { '@type': 'ListItem', position: 3, name: data.couple, item: absolute(`/casamentos/${data.slug}`) },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.couple} — casamento em ${data.city} (${data.state})`}
  description={data.seoDescription ?? data.excerpt}
  canonical={`/casamentos/${data.slug}`}
  ogImage={data.cover.src}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <Hero
      image={data.cover}
      alt={`${data.couple} — ${data.excerpt}`}
      eyebrow={data.venue ? `${data.venue} · ${data.city}/${data.state}` : `${data.city}/${data.state}`}
      title={data.couple}
      ctas={[{ label: 'Ver a galeria', href: '#galeria', primary: true }, { label: 'Conheça o fotógrafo', href: '/sobre' }]}
    />

    <div class="bg-background">
      <div class="mx-auto max-w-(--content-max) px-4 py-10 sm:px-6">
        <Breadcrumbs items={[{ label: 'Casamentos', href: '/casamentos' }, { label: data.couple }]} />
      </div>
    </div>

    {/* Intro */}
    <section class="mx-auto max-w-3xl px-4 sm:px-6" aria-label="Sobre o casamento">
      <div class="reveal border-y border-line py-12 text-center sm:py-16">
        <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">
          {formatDate(data.date)}
        </p>
        <h1 class="sr-only">{data.couple}</h1>
        <p class="mx-auto mt-6 max-w-xl font-display text-2xl font-normal leading-snug text-text sm:text-3xl">
          {data.description}
        </p>
        <p class="mt-6 text-sm text-muted">
          {data.location}, {data.city} — {data.state}
        </p>
      </div>
    </section>

    {/* Galeria editorial */}
    <section id="galeria" class="mx-auto max-w-(--content-max) px-4 pt-16 sm:px-6 sm:pt-20" aria-label="Galeria de fotos">
      <div class="reveal mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">Galeria</p>
          <h2 class="mt-2 font-display text-3xl font-medium tracking-tight sm:text-4xl">
            {data.couple} na íntegra
          </h2>
        </div>
        <p class="max-w-xs text-sm text-muted">{galleryImages.length} fotografias curadas</p>
      </div>
      <Gallery id={`galeria-${data.slug}`} items={galleryItems} />
    </section>

    {/* A história */}
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6" aria-label="A história do casamento">
      <div class="reveal story mb-12">
        <Content />
      </div>
    </section>

    {/* Fornecedores */}
    {data.vendors.length > 0 ? (
      <section class="mx-auto max-w-(--content-max) px-4 pb-20 sm:px-6" aria-label="Fornecedores">
        <h2 class="reveal font-display text-2xl font-medium tracking-tight">Fornecedores</h2>
        <ul class="reveal mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 sm:grid-cols-3">
          {data.vendors.map((vendor) => (
            <li class="text-sm">
              <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted">{vendor.role}</span>
              {vendor.instagram ? (
                <a
                  href={`https://www.instagram.com/${vendor.instagram}`}
                  target="_blank"
                  rel="noopener"
                  class="link-line mt-1 inline-block text-text"
                >
                  {vendor.name}
                </a>
              ) : (
                <span class="mt-1 block text-text">{vendor.name}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <CTA title={`E agora, será o dia de ${data.couple === 'Laura e Diego' ? 'vocês como eles' : 'vocês'}?`} />
  </article>

  {related.length > 0 ? (
    <section class="bg-background py-20">
      <div class="mx-auto max-w-(--content-max) px-4 sm:px-6">
        <div class="reveal mb-10 max-w-2xl">
          <p class="text-xs font-medium uppercase tracking-[0.24em] text-accent">Continue vendo</p>
          <h2 class="mt-2 font-display text-3xl font-medium tracking-tight sm:text-4xl">Mais histórias</h2>
          <p class="mt-3 text-muted">Casamentos com clima e região parecidos com o de {data.couple}.</p>
        </div>
        <WeddingGrid weddings={related} />
      </div>
    </section>
  ) : null}
</BaseLayout>